{
  "name": "pongnapat-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "prepare:media": "node scripts/process-media.mjs",
    "prepare:assets": "node scripts/generate-assets.mjs",
    "dev": "pnpm run prepare:media && pnpm run prepare:assets && astro dev --host 0.0.0.0",
    "build": "pnpm run prepare:media && pnpm run prepare:assets && astro build",
    "check": "pnpm run prepare:media && pnpm run prepare:assets && astro check",
    "preview": "astro preview --host 0.0.0.0 --port 3000"
  },
  "dependencies": {
    "astro": "6.4.8",
    "gray-matter": "4.0.3",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@types/node": "26.6.5",
    "@types/three": "0.186.0",
    "typescript": "6.0.3"
  }
}
