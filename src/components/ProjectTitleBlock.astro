---
import type { SiteSettings } from '../lib/schemas';

interface Props {
  projectNumber: string;
  role: string;
  tools: string[];
  dates: string;
  spec: string;
  site: SiteSettings;
}

const { projectNumber, role, tools, dates, spec, site } = Astro.props;
const labels = site.pages.project;
---
<section class="project-title-block" aria-label={labels.contextLabel}>
  <dl class="project-title-block__fields">
    <div class="project-title-block__field project-title-block__field--number">
      <dt>{labels.projectNumberLabel}</dt>
      <dd>{projectNumber}</dd>
    </div>
    <div class="project-title-block__field">
      <dt>{labels.roleLabel}</dt>
      <dd>{role}</dd>
    </div>
    <div class="project-title-block__field">
      <dt>{labels.toolsLabel}</dt>
      <dd>{tools.length ? tools.join(' · ') : labels.toolsPlaceholder}</dd>
    </div>
    <div class="project-title-block__field">
      <dt>{labels.datesLabel}</dt>
      <dd>{dates}</dd>
    </div>
  </dl>
  <p class="project-title-block__spec" aria-label={`${labels.resultsHeading}: ${spec}`}>{spec}</p>
</section>
