---
import type { Project, SiteSettings } from '../lib/schemas';

interface Props {
  projects: Project[];
  site: SiteSettings;
}

const { projects, site } = Astro.props;
const compactResult = (value: string | number): string => {
  const text = String(value).trim();
  return text.match(/^(\d+(?:\.\d+)?\s*(?:mm\/s|mm|N|°|%))/i)?.[1] ?? text;
};
---
<section class="featured-section page-wrap" id="selected-work" aria-labelledby="featured-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{site.homepage.featuredEyebrow}</p>
      <h2 id="featured-heading">{site.homepage.featuredHeading}<span class="section-heading__period">.</span></h2>
    </div>
    <a class="text-link section-heading__link" href={site.homepage.featuredLinkHref}>
      {site.homepage.featuredLink}
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" /></svg>
    </a>
  </div>
  <div class="project-grid">
    {projects.map((project, index) => (
      <article class="project-preview" id={project.slug}>
        <div
          class="project-preview__cover"
          role="img"
          aria-label={`${site.homepage.imagePlaceholderAlt} for ${project.title}; add ${project.cover}`}
        >
          <span class="project-preview__cover-index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <span class="project-preview__cover-file" aria-hidden="true">{project.cover}</span>
          <span class="project-preview__cover-note" aria-hidden="true">{site.homepage.imagePlaceholderPrefix}</span>
        </div>
        <div class="project-preview__meta">
          <p class="eyebrow project-preview__category">{project.category}</p>
          <span class="project-preview__date">{project.startDate.slice(0, 4)}</span>
        </div>
        <h3 class="project-preview__title">{project.title}</h3>
        <p class="project-preview__summary">{project.summary}</p>
        {project.results.length > 0 && (
          <p class="project-preview__spec" aria-label={`Key results: ${project.results.join('; ')}`}>
            {project.results.map(compactResult).join(' · ')}
          </p>
        )}
      </article>
    ))}
  </div>
</section>
