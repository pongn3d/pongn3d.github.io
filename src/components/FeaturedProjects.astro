---
import type { Project, SiteSettings } from '../lib/schemas';
import { assetUrl } from '../lib/url';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
  site: SiteSettings;
}

const { projects, site } = Astro.props;
---
<section class="featured-section page-wrap" id="selected-work" aria-labelledby="featured-heading">
  <div class="section-heading">
    <div>
      <p class="eyebrow">{site.homepage.featuredEyebrow}</p>
      <h2 id="featured-heading">{site.homepage.featuredHeading}<span class="section-heading__period">.</span></h2>
    </div>
    <a class="text-link section-heading__link" href={assetUrl(site.homepage.featuredLinkHref)}>
      {site.homepage.featuredLink}
      <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3.5 10h12m-5-5 5 5-5 5" /></svg>
    </a>
  </div>
  <div class="project-grid">
    {projects.map((project, index) => <ProjectCard project={project} site={site} index={index} />)}
  </div>
</section>
