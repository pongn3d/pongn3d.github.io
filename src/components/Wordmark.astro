---
import type { SiteSettings } from '../lib/schemas';
import { assetUrl } from '../lib/url';

interface Props {
  site: SiteSettings;
  href?: string;
}

const { site, href = assetUrl('/') } = Astro.props;
const word = site.wordmark.endsWith('.') ? site.wordmark.slice(0, -1) : site.wordmark;
const logoMarkHref = `${assetUrl(site.assets.logoMark)}#p-mark`;
---
<a class="wordmark" href={href} aria-label={`${site.name} — home`}>
  <svg class="wordmark__mark" viewBox="0 0 86.86 100" aria-hidden="true" focusable="false">
    <use href={logoMarkHref}></use>
  </svg>
  <span>{word}<span class="wordmark__period">.</span></span>
</a>
