---
import type { SiteSettings } from '../lib/schemas';
import { assetUrl } from '../lib/url';

interface Props {
  site: SiteSettings;
  href?: string;
}

const { site, href = assetUrl('/') } = Astro.props;
const word = site.wordmark.endsWith('.') ? site.wordmark.slice(0, -1) : site.wordmark;
---
<a class="wordmark" href={href} aria-label={`${site.name} — home`}>
  <svg class="wordmark__spark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
    <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="2">
      <path d="M24 5v38M5 24h38M10.6 10.6l26.8 26.8M37.4 10.6 10.6 37.4" />
    </g>
    <circle cx="24" cy="24" r="2.5" fill="var(--terra)" />
  </svg>
  <span>{word}<span class="wordmark__period">.</span></span>
</a>
