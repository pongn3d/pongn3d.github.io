---
import Wordmark from './Wordmark.astro';
import type { SiteSettings } from '../lib/schemas';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="page-wrap">
    <div class="site-footer__top">
      <Wordmark site={site} />
      <p class="site-footer__manifesto">{site.footer.manifesto}</p>
      <a class="text-link site-footer__back" href="#top">{site.footer.backToTopLabel} <span aria-hidden="true">↑</span></a>
    </div>
    <div class="site-footer__bottom">
      <nav class="site-footer__nav" aria-label={site.labels.footerNavigation}>
        {site.navigation.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="site-footer__socials" aria-label={site.labels.socialLinks}>
        <a href={site.contact.linkedin} target="_blank" rel="noreferrer" aria-label={site.footer.socialLabels.linkedin}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 8.4H3.2V21h3.3V8.4ZM4.85 3a1.92 1.92 0 1 0 0 3.84 1.92 1.92 0 0 0 0-3.84ZM21 13.8c0-3.78-2.02-5.54-4.72-5.54a4.08 4.08 0 0 0-3.68 2.03V8.4H9.3V21h3.3v-6.24c0-1.64.32-3.22 2.34-3.22 1.99 0 2.01 1.87 2.01 3.33V21H21v-7.2Z" /></svg>
        </a>
        <a href={site.contact.github} target="_blank" rel="noreferrer" aria-label={site.footer.socialLabels.github}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.76-1.32-3.76-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.17 1.73 1.17 1 .1.56 2.6 4.58 1.84.1-.73.4-1.23.72-1.51-2.48-.28-5.09-1.24-5.09-5.5 0-1.22.44-2.22 1.17-3-.12-.28-.5-1.42.11-2.95 0 0 .96-.3 3.05 1.15a10.6 10.6 0 0 1 5.56 0c2.1-1.45 3.05-1.15 3.05-1.15.61 1.53.23 2.67.11 2.95.73.78 1.17 1.78 1.17 3 0 4.27-2.61 5.21-5.1 5.49.4.35.76 1.02.76 2.06v3.13c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" /></svg>
        </a>
        <a href={`mailto:${site.contact.email}`} aria-label={site.footer.socialLabels.email}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1v-11a1 1 0 0 1 1-1Zm9 7.1 8.14-5.35H3.86L12 12.6Zm-9 4.9h18V9.63l-7.45 4.9a2.8 2.8 0 0 1-3.1 0L3 9.63v7.87Z" /></svg>
        </a>
      </div>
      <p class="site-footer__copyright">© {year} {site.footer.copyrightName}</p>
    </div>
  </div>
</footer>
