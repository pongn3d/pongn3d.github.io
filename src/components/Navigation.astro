---
import Wordmark from './Wordmark.astro';
import type { SiteSettings } from '../lib/schemas';

interface Props {
  site: SiteSettings;
}

const { site } = Astro.props;
---
<header class="site-header">
  <div class="site-header__inner page-wrap">
    <Wordmark site={site} />
    <nav class="site-nav" aria-label={site.labels.primaryNavigation}>
      {site.navigation.map((item) => (
        <a class:list={["site-nav__link", item.label === 'Contact' && 'site-nav__contact']} href={item.href}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>
