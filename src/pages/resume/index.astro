---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { site } from '../../lib/schemas';
import { assetUrl } from '../../lib/url';
import { isPlaceholder } from '../../lib/placeholder';
import { getResume } from '../../lib/resume';
const page = site.pages.resume;
const resume = getResume();
---
<BaseLayout title={page.title} description={page.description}>
  <main id="main-content" class="page-wrap content-page resume-page">
    <PageHeader eyebrow={page.eyebrow} heading={page.heading} />
    <section class="resume-placeholder" aria-label={page.heading}>
      {resume ? (
        <p class="resume-download">
          <a class="resume-download__button" href={resume.href} download>{resume.label}<span class="resume-download__size">PDF · {resume.size}</span></a>
          <a class="text-link" href={resume.href} target="_blank" rel="noopener">Open in a new tab<span aria-hidden="true"> ↗</span></a>
        </p>
      ) : !isPlaceholder(page.downloadPlaceholder) && <p class="eyebrow">{page.downloadPlaceholder}</p>}
      <p class="resume-placeholder__note">{page.contactLabel}</p>
      <a class="text-link resume-placeholder__link" href={assetUrl('/contact/')}>{site.pages.contact.heading}<span aria-hidden="true"> ↗</span></a>
    </section>
  </main>
</BaseLayout>
